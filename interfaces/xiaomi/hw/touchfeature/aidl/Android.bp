soong_config_module_type {
    name: "xiaomi_touchfeature_aidl_interface",
    module_type: "aidl_interface",
    config_namespace: "xiaomi",
    bool_variables: ["disable_touchfeature_aidl"],
    properties: ["enabled"],
}

xiaomi_touchfeature_aidl_interface {
    name: "vendor.xiaomi.hw.touchfeature",
    vendor_available: true,
    srcs: [
        "vendor/xiaomi/hw/touchfeature/*.aidl",
    ],
    stability: "vintf",
    backend: {
        java: {
            sdk_version: "module_current",
            min_sdk_version: "30",
            lint: {
                // Disable linter to avoid error about fixed size arrays.
                // Interface will only be accessed on devices >= U.
                enabled: false,
            },
        },
    },
    owner: "xiaomi",
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
    soong_config_variables: {
        disable_touchfeature_aidl: {
            enabled: false,
            conditions_default: {
                enabled: true,
            },
        },
    },
}